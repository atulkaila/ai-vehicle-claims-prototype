# Phase 2: server-only environment variables. Never prefix with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in the values.

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vision-capable model. gpt-4o-mini is the cheapest option that supports images.
OPENAI_MODEL=gpt-4o-mini
